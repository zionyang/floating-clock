{
  "name": "floating-clock",
  "version": "0.1.0",
  "description": "A floating Windows clock with marketplace time-source switching and countdown mode.",
  "main": "src/main.js",
  "scripts": {
    "package:win": "electron-packager . FloatingClock --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=src/assets/tray-clock.ico --ignore=^/\\.agents --ignore=^/\\.codex --ignore=^/test",
    "start": "electron .",
    "test": "node --test"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "electron": "^37.0.0"
  }
}
